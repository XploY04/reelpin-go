# Every variable config.Load() reads. Names only: fill a copy of this file in,
# never this one. The comment on each says what it does and what happens when it
# is left empty.

# Process
# ENVIRONMENT is one of development, test, production. Empty means development.
ENVIRONMENT=
# The API port. Empty means 8000.
PORT=
# Where the worker exposes Prometheus. Empty means 9100.
METRICS_PORT=
# Reported on /health and stamped on logs. Empty means dev.
APP_VERSION=
# Names this process in leases and consumer tags. Empty means hostname-pid,
# which is distinct per host and good enough outside production.
WORKER_ID=

# PostgreSQL and Supabase Auth
# Empty is refused in production; elsewhere it falls back to the local database.
DATABASE_URL=
# The Supabase project. Empty is refused outside the test environment: without
# it there is no JWKS to verify a token against.
SUPABASE_URL=
# The audience claim tokens must carry. Empty means authenticated.
SUPABASE_JWT_AUDIENCE=

# Redis
# Rate limits and worker heartbeats. Empty is refused in production, because
# submissions fail closed without limits; elsewhere everything Redis-backed is
# simply off and this worker is invisible to readiness.
REDIS_URL=
# Namespaces every key. Empty means reelpin.
REDIS_KEY_PREFIX=
# Keys the hash that keeps user ids and IPs out of Redis keys and logs. Empty is
# refused in production; elsewhere one is generated per process, which resets
# every rate window on restart.
RATE_LIMIT_SALT=

# RabbitMQ
# The broker the worker consumes and the outbox publishes to. Empty stops the
# worker at startup: a worker without a broker consumes nothing. The API never
# touches it.
RABBITMQ_URL=

# Admin and the web boundary
# Guards the Prometheus endpoints. Empty means neither process exposes one.
ADMIN_KEY=
# Shared with the Next.js boundary, which is the only hop that sees a browser's
# real address. Empty means no forwarded bucket is believed and per-IP limits
# use the socket peer, which puts every web visitor in one bucket.
REELPIN_IP_BUCKET_SECRET=

# Deletes the identity in Supabase when an account is deleted, through the
# Admin API. Empty means an account deletion removes every row, leaves the
# sign-in working, and stays pending until a key is set.
SUPABASE_SERVICE_ROLE_KEY=

# The origin a collection share or invite link is built on: the web boundary's
# domain, not this service's.
SHARE_BASE_URL=https://reelpin.in

# Gemini
# The model credential for transcription, extraction, categorization and
# embeddings. Empty means every provider call fails as unconfigured, which the
# pipeline surfaces as a retryable provider error rather than a crash.
GEMINI_API_KEY=
# The embedding model. Empty means gemini-embedding-2. The index holds exactly
# one dimension, so changing this needs a reindex, not a restart.
EMBEDDING_MODEL=

# Apify
# Pays for the actor runs that reach what a plain fetch cannot. Empty means
# every actor rung reports itself unconfigured: handlers take their free paths,
# and a LinkedIn feed post, which has no free path, fails as unavailable.
APIFY_API_TOKEN=
# Comma-separated platform=owner/actor pairs, for example
# instagram=apify/instagram-scraper. A platform absent from the list has no
# actor however set the token is. Malformed pairs stop the worker at startup.
APIFY_ACTORS=

# Reddit
# The application credentials. Empty means the handler reads Reddit's public
# JSON view, which Reddit throttles hard from datacenter addresses.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Supabase Storage
# Writes thumbnails. Empty means no thumbnail is stored, which is cosmetic: a
# run still completes and saves.
SUPABASE_SERVICE_ROLE_KEY=
# The bucket thumbnails go in. Empty means reel-thumbnails.
REEL_THUMBNAIL_BUCKET=

# Instagram cookie slots
# Base64 Netscape cookie files, tried in this order. Each spends a real
# account's standing, so they are the last rung of the download ladder. All
# empty means that rung is skipped and Instagram gets whatever the free rungs
# reach. Malformed data is skipped rather than failing startup.
INSTAGRAM_ACTIVE_COOKIE_DATA_BASE64=
INSTAGRAM_BACKUP_COOKIE_DATA_BASE64=
INSTAGRAM_TERTIARY_COOKIE_DATA_BASE64=

# Media tools
# Where the binaries live. Empty means the names on PATH: yt-dlp and ffmpeg.
YT_DLP_PATH=
FFMPEG_PATH=

# Firebase
# Push notifications. Empty means a run still completes and its notification
# records that there was nowhere to send it.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# The cost gate
# All four together enable it; none of them leaves spending unlimited. Anything
# in between is refused at startup, because a limit assembled from half a
# decision is a limit nobody made. With no prices, provider calls are still
# counted and stored, valued at zero and reported as unpriced.
COST_GATE_WARN_USD=
COST_GATE_STOP_USD=
COST_GATE_STOP_ORDER=
COST_GATE_PRICES=
