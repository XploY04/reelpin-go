# Process
ENVIRONMENT=development
PORT=8000
APP_VERSION=dev

# PostgreSQL and Supabase Auth
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Shared with the Next.js boundary, which is the only hop that sees a browser's
# real address. Empty means no forwarded bucket is believed and per-IP limits
# use the socket peer, which puts every web visitor in one bucket.
REELPIN_IP_BUCKET_SECRET=
