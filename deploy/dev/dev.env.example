# Template for /etc/reelpin/dev.env on reelpin-ec2-dev. Mode 0600, root-owned.
# Copy it, fill the blanks, and never commit the filled copy.
#
# The Python stack keeps /etc/reelpin/reelpin.env. This file is the Go stack's
# and the two never share a name or a port.

ENVIRONMENT=development
APP_VERSION=
WORKER_ID=dev-1

# Go serves v2 on 8080; Python keeps 8000. Nginx routes ^~ /api/v2/ here.
PORT=8080
METRICS_PORT=9101

# The development Supabase project, not production.
DATABASE_URL=
SUPABASE_URL=https://aiiybsztucruputflayb.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# This stack's own Redis on 6380. Python keeps 6379 and the prefix keeps the
# two apart even if that is ever untrue.
REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=reelpin:dev:
RATE_LIMIT_SALT=

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Guards /metrics. Empty means the endpoint is not mounted at all, which is the
# safe default: a misconfigured deploy then exposes nothing.
ADMIN_KEY=

# Must match the value in Vercel for the same environment, or Go ignores the
# forwarded bucket and every web visitor shares one rate-limit bucket.
REELPIN_IP_BUCKET_SECRET=

SHARE_BASE_URL=https://dev.reelpin.in

GEMINI_API_KEY=
EMBEDDING_MODEL=

APIFY_API_TOKEN=
APIFY_ACTORS=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REEL_THUMBNAIL_BUCKET=reel-thumbnails
YT_DLP_PATH=
FFMPEG_PATH=

FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# All four or none. Some set and some not refuses to start rather than guessing
# a spending limit. Empty means the gate is off and spend is still measured,
# which is what fills the ledger before the amounts are chosen.
COST_GATE_WARN_USD=
COST_GATE_STOP_USD=
COST_GATE_STOP_ORDER=
COST_GATE_PRICES=
