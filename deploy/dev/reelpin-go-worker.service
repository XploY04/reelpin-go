[Unit]
Description=ReelPin Go worker (development)
After=docker.service redis-server.service network-online.target
Requires=docker.service

[Service]
Type=exec
Restart=always
RestartSec=5
EnvironmentFile=/etc/reelpin/dev.env
EnvironmentFile=/etc/reelpin/reelpin-worker-dev.image
ExecStartPre=-/usr/bin/docker rm -f reelpin-worker-dev
# Media is disk-backed, not tmpfs: a 500 MiB admitted video must not consume
# half of this host's RAM. The application stops admission at 80 percent disk
# and removes each run directory on every terminal outcome.
ExecStart=/usr/bin/docker run --rm --name reelpin-worker-dev \
  --env-file /etc/reelpin/dev.env \
  --network host \
  --read-only --volume /var/lib/reelpin/work:/var/tmp/reelpin-runs \
  --user 10001:10001 \
  --memory 640m --memory-swap 1024m --cpus 1.25 --pids-limit 256 \
  --entrypoint /usr/local/bin/reelpin-worker \
  ${REELPIN_IMAGE}
ExecStop=/usr/bin/docker stop --timeout 30 reelpin-worker-dev

[Install]
WantedBy=multi-user.target
