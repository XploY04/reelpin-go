[Unit]
Description=ReelPin Go API (development)
# Python is stopped on this constrained host. The Go API reuses its localhost
# Redis with a different key prefix.
After=docker.service redis-server.service network-online.target
Requires=docker.service

[Service]
Type=exec
Restart=always
RestartSec=5
# The image is deployed by digest. reelpin-deploy.sh writes this file; the
# digest is never a tag, so a rollback is a redeploy of the previous one.
EnvironmentFile=/etc/reelpin/dev.env
EnvironmentFile=/etc/reelpin/reelpin-api-dev.image
ExecStartPre=-/usr/bin/docker rm -f reelpin-api-dev
ExecStart=/usr/bin/docker run --rm --name reelpin-api-dev \
  --env-file /etc/reelpin/dev.env \
  --env HEALTHCHECK_URL=http://127.0.0.1:8080/api/v2/health/live \
  --network host \
  --read-only --tmpfs /var/tmp/reelpin-runs:size=16m,uid=10001,gid=10001,mode=0700 \
  --user 10001:10001 \
  --memory 192m --memory-swap 256m --cpus 0.30 --pids-limit 128 \
  --entrypoint /usr/local/bin/reelpin-api \
  ${REELPIN_IMAGE}
ExecStop=/usr/bin/docker stop --timeout 15 reelpin-api-dev

[Install]
WantedBy=multi-user.target
