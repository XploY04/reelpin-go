[Unit]
Description=ReelPin daily price check
Documentation=https://github.com/XploY04/reelpin-go
# The database is the only hard dependency. A failed run records nothing it
# did not finish, and tomorrow's run picks up every track still stale.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=reelpin
Group=reelpin
EnvironmentFile=/etc/reelpin/production.env
ExecStart=/usr/local/bin/reelpin-maintenance check-price-tracks

# Every page read has its own 15 second budget; this bounds the whole run.
TimeoutStartSec=1h

# Read-only root with one writable temp: this command writes only to the
# database and reaches the network only through the SSRF-guarded client.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
