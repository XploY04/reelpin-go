[Unit]
Description=Run the ReelPin price check daily
Documentation=https://github.com/XploY04/reelpin-go

[Timer]
# 03:00 UTC every day, in UTC explicitly so a host timezone change cannot move
# the run into peak hours. The check treats anything older than 20 hours as
# due, so the randomized start never skips a track for a day.
OnCalendar=*-*-* 03:00:00 UTC
# A host that was down at 03:00 still checks when it comes back.
Persistent=true
RandomizedDelaySec=15min
Unit=reelpin-price-tracks.service

[Install]
WantedBy=timers.target
